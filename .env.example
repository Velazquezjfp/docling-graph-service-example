# Copy to .env on each machine and uncomment ONE machine block below. .env is gitignored and never synced;
# THIS file is the shared template — when a value changes on one machine, mirror it here so both stay parallel.
# Read by docker compose (build args + runtime) and by the service itself (native runs).

# ============================ machine block: DEV BOX (WSL2, LiteLLM proxy on localhost:4000) ==================
# run with: docker compose --profile local up -d          (host networking; endpoints on the host loopback)
DGS__LLM__BASE_URL=http://localhost:4000/v1
DGS__LLM__API_KEY=sk-123456789
DGS__LLM__MODEL=gemini-dev
DGS__VLM__ENABLED=true
DGS__VLM__MODEL=gemini-dev
DGS__EMBEDDING__MODEL=bge-m3
DGS__EMBEDDING__DIM=1024
DGS__EMBEDDING__TEXT_PREFIX=
ONTOLOGY_DIR=../user-manual-books/handbuch_daten/Ontologie
IMAGE=dgs:local

# ============================ machine block: REMOTE SERVER (models via SSH tunnels on localhost) ==============
# run with: docker compose --profile local up -d          (host networking reaches the tunnels on 127.0.0.1)
# DGS__LLM__BASE_URL=http://localhost:11435/v1
# DGS__LLM__API_KEY=none
# DGS__LLM__MODEL=<id from GET /v1/models>
# DGS__LLM__CONTEXT_LIMIT=131072
# DGS__LLM__MAX_OUTPUT_TOKENS=8192
# DGS__LLM__STRUCTURED_OUTPUT=true       # false if the endpoint rejects response_format=json_schema
# DGS__VLM__ENABLED=false                # until the vision endpoint exists (nothing else changes)
# DGS__VLM__BASE_URL=
# DGS__VLM__MODEL=
# DGS__EMBEDDING__BASE_URL=http://localhost:11435/v1
# DGS__EMBEDDING__MODEL=<embedding model id>
# DGS__EMBEDDING__DIM=1024               # 768 for embeddinggemma / nomic
# DGS__EMBEDDING__TEXT_PREFIX=           # "passage: " for multilingual-e5-large; "title: none | text: " for embeddinggemma
# ONTOLOGY_DIR=/abs/path/to/user-manual-books/handbuch_daten/Ontologie
# SELINUX_LABEL=,Z                       # RHEL/CentOS with SELinux enforcing
# IMAGE=dgs:0.1.0
#
# ---- build args, remote server (docker compose --profile enterprise build) ----
# BASE_IMAGE=<registry>/python:3.12      # full image (has libGL/glib/curl); -slim needs apt access to deb.debian.org
# PIP_INDEX_URL=https://<artifactory>/api/pypi/<repo>/simple
# PIP_EXTRA_INDEX_URL=                   # empty: torch from PIP_INDEX_URL (CUDA wheel; runs on CPU; bigger image)
# PIP_TRUSTED_HOST=                      # only if pip reports CERTIFICATE_VERIFY_FAILED
# HF_ENDPOINT=https://huggingface.co     # default; models are fetched through the proxy below
# HTTP_PROXY=http://<proxy>:<port>       # set BOTH spellings — apt reads only the lowercase ones
# HTTPS_PROXY=http://<proxy>:<port>
# NO_PROXY=localhost,127.0.0.1,<artifactory-host>,<registry-host>,.<internal-domain>
# http_proxy=http://<proxy>:<port>
# https_proxy=http://<proxy>:<port>
# no_proxy=localhost,127.0.0.1,<artifactory-host>,<registry-host>,.<internal-domain>

# ============================ later: real deployment (endpoints are hostnames, no tunnels) ====================
# run with: docker compose --profile enterprise up -d     (published port; PORT=8080 to change)
# DGS__LLM__BASE_URL=http://vllm.internal:8000/v1  etc.
