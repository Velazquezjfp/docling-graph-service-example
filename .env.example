# Copy to .env (never commit .env). Read by docker compose (build args + runtime) and by the service itself.

# ---- runtime: the three endpoints (OpenAI-compatible roots that have /chat/completions or /embeddings)
DGS__LLM__BASE_URL=http://localhost:4000/v1
DGS__LLM__API_KEY=sk-123456789          # vLLM without auth: any non-empty value, e.g. none
DGS__LLM__MODEL=gemini-dev              # exactly the id GET <base_url>/models returns
# DGS__LLM__CONTEXT_LIMIT=131072
# DGS__LLM__MAX_OUTPUT_TOKENS=8192
# DGS__LLM__STRUCTURED_OUTPUT=true      # false if the endpoint rejects response_format=json_schema

DGS__VLM__ENABLED=true                  # false until the vision endpoint exists (nothing else changes)
# DGS__VLM__BASE_URL=                   # default: llm base_url
# DGS__VLM__API_KEY=
DGS__VLM__MODEL=gemini-dev

# DGS__EMBEDDING__BASE_URL=             # default: llm base_url
# DGS__EMBEDDING__API_KEY=
DGS__EMBEDDING__MODEL=bge-m3            # production: intfloat/multilingual-e5-large with TEXT_PREFIX="passage: "
DGS__EMBEDDING__DIM=1024
DGS__EMBEDDING__TEXT_PREFIX=

# ---- runtime: paths (compose sets CACHE_DIR/DEFAULT_ONTOLOGY_PATH inside the container itself)
# DGS__SERVICE__CACHE_DIR=.cache/dgs    # native runs only
ONTOLOGY_DIR=../user-manual-books/handbuch_daten/Ontologie   # host dir mounted read-only at /ontology
# SELINUX_LABEL=,Z                      # RHEL/CentOS with SELinux enforcing
# PORT=8080

# ---- build (docker compose build): leave unset for a public-internet build
# BASE_IMAGE=registry.example.internal/python:3.12-slim
# PIP_INDEX_URL=https://artifactory.example.internal/api/pypi/pypi/simple
# PIP_EXTRA_INDEX_URL=                  # empty = no PyTorch-CPU index: torch comes from PIP_INDEX_URL (CUDA wheel, works on CPU, bigger image)
# PIP_TRUSTED_HOST=artifactory.example.internal
# HF_ENDPOINT=https://artifactory.example.internal/api/huggingfaceml/hf
# HTTP_PROXY=http://proxy.example.internal:3128
# HTTPS_PROXY=http://proxy.example.internal:3128
# NO_PROXY=localhost,127.0.0.1,.example.internal
# IMAGE=dgs:0.1.0
